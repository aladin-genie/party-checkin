# Party Check-In System — Streamlit Secrets (local example)
# DO NOT commit this file to version control!
# On Streamlit Community Cloud, set these via Dashboard → Secrets.

SECRET_KEY = "your-secret-key-here"
DATABASE_URL = "sqlite:///party_guests.db"

# Email (Gmail SMTP example)
MAIL_SERVER = "smtp.gmail.com"
MAIL_PORT = "587"
MAIL_USERNAME = "your-email@gmail.com"
MAIL_PASSWORD = "your-app-password"
MAIL_DEFAULT_SENDER = "your-email@gmail.com"

# Admin password (leave empty for no protection)
ADMIN_PASSWORD = "admin123"

# Ticket price in cents (e.g., 2000 = $20.00)
TICKET_PRICE_CENTS = "2000"

# Zelle payment info (shown to guests on registration page)
ZELLE_INFO = "dallashudugaru@gmail.com"

# Stripe (optional — kept for backwards compatibility)
STRIPE_SECRET_KEY = ""
STRIPE_PUBLISHABLE_KEY = ""
STRIPE_WEBHOOK_SECRET = ""
